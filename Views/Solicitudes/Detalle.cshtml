@model PRACTICA_NRO_2_TEORIA_20262.Models.SolicitudCredito

@{
    ViewData["Title"] = "Detalle de Solicitud";
}

<div class="container mt-4">
    <h2>Detalle de la Solicitud #@Model.Id</h2>

    <div class="card mt-3">
        <div class="card-header">
            Información General
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Monto Solicitado</dt>
                <dd class="col-sm-9">@Model.MontoSolicitado.ToString("C")</dd>

                <dt class="col-sm-3">Fecha de Solicitud</dt>
                <dd class="col-sm-9">@Model.FechaSolicitud.ToString("dd/MM/yyyy HH:mm:ss")</dd>

                <dt class="col-sm-3">Estado</dt>
                <dd class="col-sm-9">
                    <span class="badge @(Model.Estado == PRACTICA_NRO_2_TEORIA_20262.Models.EstadoSolicitud.Aprobado ? "bg-success" : Model.Estado == PRACTICA_NRO_2_TEORIA_20262.Models.EstadoSolicitud.Rechazado ? "bg-danger" : "bg-warning text-dark") fs-6">
                        @Model.Estado
                    </span>
                </dd>

                @if (Model.Estado == PRACTICA_NRO_2_TEORIA_20262.Models.EstadoSolicitud.Rechazado && !string.IsNullOrEmpty(Model.MotivoRechazo))
                {
                    <dt class="col-sm-3 text-danger">Motivo de Rechazo</dt>
                    <dd class="col-sm-9 text-danger">@Model.MotivoRechazo</dd>
                }
            </dl>
        </div>
        <div class="card-footer">
            <a asp-action="MisSolicitudes" class="btn btn-secondary">Volver al listado</a>
        </div>
    </div>
</div>