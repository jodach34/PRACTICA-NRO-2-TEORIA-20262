@model PRACTICA_NRO_2_TEORIA_20262.Models.FiltroSolicitudesViewModel

@{
    ViewData["Title"] = "Mis Solicitudes";
}

<div class="container mt-4">
    <h2>Mis Solicitudes de Crédito</h2>

    @if (ViewBag.UltimaVista != null)
    {
        <div class="alert alert-info mt-2">
            <strong>Reciente:</strong> La última solicitud que revisaste fue la #@ViewBag.UltimaVista.
        </div>
    }

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
            @TempData["MensajeExito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="mb-3 mt-3">
        <a asp-action="Crear" class="btn btn-success">Nueva Solicitud</a>
    </div>

    <!-- Formulario de Filtros -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" asp-action="MisSolicitudes">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Estado</label>
                        <select asp-for="Estado" class="form-select" asp-items="Html.GetEnumSelectList<PRACTICA_NRO_2_TEORIA_20262.Models.EstadoSolicitud>()">
                            <option value="">Todos</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Monto Mín.</label>
                        <input asp-for="MontoMinimo" type="number" step="0.01" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Monto Máx.</label>
                        <input asp-for="MontoMaximo" type="number" step="0.01" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Fecha Inicio</label>
                        <input asp-for="FechaInicio" type="date" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Fecha Fin</label>
                        <input asp-for="FechaFin" type="date" class="form-control" />
                    </div>
                    <div class="col-md-1 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">Filtrar</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla de Resultados -->
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Fecha</th>
                <th>Monto</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Solicitudes != null && Model.Solicitudes.Any())
            {
                foreach (var item in Model.Solicitudes)
                {
                    <tr id="fila-@item.Id">
                        <td>@item.Id</td>
                        <td>@item.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@item.MontoSolicitado.ToString("C")</td>
                        <td>
                            <!-- Agregamos un ID al badge para cambiarle el color e icono en tiempo real -->
                            <span id="estado-@item.Id" class="badge @(item.Estado == PRACTICA_NRO_2_TEORIA_20262.Models.EstadoSolicitud.Aprobado ? "bg-success" : item.Estado == PRACTICA_NRO_2_TEORIA_20262.Models.EstadoSolicitud.Rechazado ? "bg-danger" : "bg-warning text-dark")">
                                @item.Estado
                            </span>
                        </td>
                        <td>
                            <a asp-action="Detalle" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Ver Detalle</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center">No se encontraron solicitudes.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <!-- CDN de SignalR para evitar problemas de instalación local -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    
    <script>
        // 1. Configurar la conexión con el Hub e implementar reconexión automática
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/solicitudes")
            .withAutomaticReconnect()
            .build();

        // 2. Escuchar el evento que manda el AnalistaController
        connection.on("SolicitudEstadoActualizado", function (id, estado, motivo) {
            
            // Mostrar un aviso al usuario de inmediato
            let mensaje = `Tu solicitud #${id} acaba de ser actualizada a: ${estado}.`;
            if (estado === "Rechazado" && motivo) {
                mensaje += `\nMotivo: ${motivo}`;
            }
            alert("🔔 NOTIFICACIÓN EN TIEMPO REAL\n\n" + mensaje);

            // 3. Actualizar la interfaz sin recargar la página
            const badge = document.getElementById(`estado-${id}`);
            if (badge) {
                badge.innerText = estado;
                badge.className = estado === "Aprobado" ? "badge bg-success" : "badge bg-danger";
            }
        });

        // Evento de reconexión
        connection.onreconnected(connectionId => {
            console.log("Se ha restablecido la conexión WebSocket con el servidor.");
        });

        // 4. Iniciar la escucha
        connection.start().then(function () {
            console.log("Conectado exitosamente al WebSocket de Solicitudes");
        }).catch(function (err) {
            console.error(err.toString());
        });
    </script>
}