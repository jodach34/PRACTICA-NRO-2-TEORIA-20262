@model PRACTICA_NRO_2_TEORIA_20262.Models.SolicitudCredito

@{ ViewData["Title"] = "Evaluar Solicitud"; }

<div class="container mt-4">
    <h2>Evaluar Solicitud #@Model.Id</h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger fw-bold">@TempData["Error"]</div>
    }

    <div class="card mt-4">
        <div class="card-body">
            <h5 class="card-title">Datos Financieros</h5>
            <ul>
                <li><strong>Ingresos del Cliente:</strong> @Model.Cliente?.IngresosMensuales.ToString("C")</li>
                <li><strong>Monto Solicitado:</strong> @Model.MontoSolicitado.ToString("C")</li>
                <li><strong>Límite de Aprobación (5x):</strong> @((Model.Cliente?.IngresosMensuales * 5)?.ToString("C"))</li>
            </ul>

            <hr />
            <form asp-action="Procesar" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                
                <div class="mb-3">
                    <label class="form-label text-danger">Si vas a rechazar, ingresa el motivo (Obligatorio):</label>
                    <textarea name="motivoRechazo" class="form-control" rows="2"></textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" name="accion" value="Aprobar" class="btn btn-success">Aprobar Crédito</button>
                    <button type="submit" name="accion" value="Rechazar" class="btn btn-danger">Rechazar Crédito</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>